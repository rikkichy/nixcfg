+/* The caller owns frame and must keep it alive until the throbber is stopped. */
+void
+ply_throbber_finish (ply_throbber_t     *throbber,
+                     ply_pixel_buffer_t *frame,
+                     bool                animate)
+{
+        if (throbber->is_stopped || throbber->final_frame != NULL)
+                return;
+
+        throbber->final_frame = frame;
+        throbber->final_opacity = animate ? 0.0 : 1.0;
+        throbber->finish_time = ply_get_timestamp () - throbber->start_time -
+                               (animate ? 0.0 : 0.3);
+}
