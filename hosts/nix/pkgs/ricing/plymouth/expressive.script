# Stock Plymouth script plugin; all animation images are pre-rendered.
# The native API has no monotonic clock: durations are refresh-time targets,
# not wall-clock guarantees when the event loop or renderer misses deadlines.
Plymouth.SetRefreshRate(240);
Window.SetBackgroundTopColor(0.066667, 0.074510, 0.094118);
Window.SetBackgroundBottomColor(0.066667, 0.074510, 0.094118);

font = "Google Sans Flex SemiBold 16 @wght=600,ROND=100";
title_font = "Google Sans Flex SemiBold 20 @wght=600,ROND=100";
keymap = @KEYMAP@;
boot = Plymouth.GetMode() == "boot";
clock = 0;
refresh_rate = 240;
mode = "normal";
unlocked = 0;
success_started = 0;
password_count = 0;
visible_count = 0;
mask_slots = 14;
mask_seed = Math.Random();
message_count = 0;
messages = [];
width = Window.GetWidth();
height = Window.GetHeight();
origin_x = Window.GetX();
origin_y = Window.GetY();

fun padded(number, digits)
{
    local.text = "" + number;
    while (local.text.Length() < digits)
        local.text = "0" + local.text;
    return local.text;
}

spinner_frames = [];
for (frame = 0; frame < 1092; frame++)
    spinner_frames[frame] = Image("throbber-" + padded(frame, 4) + ".png");
shape_frames = [];
for (shape = 0; shape < 7; shape++)
    for (frame = 0; frame < 12; frame++)
        shape_frames[shape * 12 + frame] = Image("bullet-" + padded(shape, 2) + "-" + padded(frame, 2) + ".png");

watermark_image = Image("watermark.png");
watermark = Sprite(watermark_image);
watermark.SetOpacity(1);
entry_image = Image("entry.png");
entry = Sprite(entry_image);
entry.SetOpacity(0);
spinner = Sprite(spinner_frames[0]);
spinner_frame = 0;
success_image = Image("unlock-success.png");
success = Sprite(success_image);
success.SetOpacity(0);
keyboard_image = Image("keyboard.png");
keyboard = Sprite(keyboard_image);
keyboard.SetOpacity(0);
caps_image = Image("capslock.png");
caps = Sprite(caps_image);
caps.SetOpacity(0);

fun label()
{
    local.item = [];
    local.item.sprite = Sprite();
    local.item.text = "";
    local.item.sprite.SetOpacity(0);
    return local.item;
}

title = label();
subtitle = label();
prompt_label = label();
question = label();
message_label = label();
layout_label = label();
masks = [];
for (slot = 0; slot < mask_slots; slot++)
{
    masks[slot].sprite = Sprite(shape_frames[11]);
    masks[slot].sprite.SetOpacity(0);
    masks[slot].index = -1;
    masks[slot].frame = 11;
}

# Text is rendered only on changes, never on each animation refresh. Long
# questions scroll inside the field; prompts/messages remain fully visible.
fun set_label(item, text, face, max_width)
{
    if (text == NULL)
        text = "";
    if (item.text == text && item.max_width == max_width)
        return;
    item.text = text;
    item.max_width = max_width;
    if (text == "")
    {
        item.image = NULL;
        item.sprite.SetOpacity(0);
        return;
    }
    item.image = Image.Text(text, 0.890196, 0.890196, 0.913725, 1, face, "center");
    if (item.image.GetWidth() > max_width)
        item.image = item.image.Scale(max_width, Math.Max(1, Math.Int(item.image.GetHeight() * max_width / item.image.GetWidth())));
    item.sprite.SetImage(item.image);
    item.sprite.SetOpacity(1);
}

fun center_label(item, y)
{
    if (item.image)
        item.sprite.SetPosition(origin_x + (width - item.image.GetWidth()) / 2, y, 3);
}

fun layout()
{
    local.cx = origin_x + width / 2;
    local.cy = origin_y + height / 2;
    watermark.SetPosition(local.cx - watermark_image.GetWidth() / 2, origin_y + (height - watermark_image.GetHeight()) * 0.25, 1);
    entry.SetPosition(local.cx - entry_image.GetWidth() / 2, local.cy - entry_image.GetHeight() / 2, 1);
    spinner.SetPosition(local.cx - spinner_frames[0].GetWidth() / 2, origin_y + height * 0.72 - spinner_frames[0].GetHeight() / 2, 1);
    success.SetPosition(local.cx - success_image.GetWidth() / 2, origin_y + height * 0.72 - success_image.GetHeight() / 2, 2);
    if (boot)
    {
        local.title_y = origin_y + (height - title.image.GetHeight() - 2 * subtitle.image.GetHeight()) / 2;
        center_label(title, local.title_y);
        center_label(subtitle, local.title_y + title.image.GetHeight() + subtitle.image.GetHeight());
    }
    if (prompt_label.image)
        prompt_label.sprite.SetPosition(local.cx - entry_image.GetWidth() / 2, local.cy - entry_image.GetHeight() / 2 - prompt_label.image.GetHeight() - 8, 3);
    center_label(message_label, origin_y + height * 0.72 + 64);
    if (question.image)
        question.sprite.SetPosition(local.cx - question.image.GetWidth() / 2, local.cy - question.image.GetHeight() / 2, 3);
    # Indicators never participate in centering the entry field.
    local.indicator_width = keyboard_image.GetWidth() + 8 + layout_label.image.GetWidth();
    local.indicator_height = Math.Max(keyboard_image.GetHeight(), layout_label.image.GetHeight());
    local.indicator_y = local.cy + entry_image.GetHeight() / 2 + local.indicator_height / 2;
    keyboard.SetPosition(local.cx - local.indicator_width / 2, local.indicator_y, 3);
    layout_label.sprite.SetPosition(local.cx - local.indicator_width / 2 + keyboard_image.GetWidth() + 8, local.indicator_y + (keyboard_image.GetHeight() - layout_label.image.GetHeight()) / 2, 3);
    caps.SetPosition(local.cx + entry_image.GetWidth() / 2 - caps_image.GetWidth(), local.indicator_y + (keyboard_image.GetHeight() - caps_image.GetHeight()) / 2, 3);
    for (local.slot = 0; local.slot < mask_slots; local.slot++)
    {
        if (masks[local.slot].index >= 0)
        {
            local.position = masks[local.slot].index - Math.Max(0, password_count - mask_slots);
            masks[local.slot].sprite.SetPosition(local.cx - visible_count * 12 + local.position * 24, local.cy - 12, 3);
        }
    }
}

fun set_refresh_rate(rate)
{
    if (refresh_rate != rate)
    {
        global.refresh_rate = rate;
        Plymouth.SetRefreshRate(rate);
    }
}

fun clear_masks()
{
    for (local.slot = 0; local.slot < mask_slots; local.slot++)
    {
        masks[local.slot].sprite.SetOpacity(0);
        masks[local.slot].index = -1;
    }
    global.password_count = 0;
    global.visible_count = 0;
    global.mask_seed = Math.Random();
}

fun show_dialog(prompt)
{
    title.sprite.SetOpacity(0);
    subtitle.sprite.SetOpacity(0);
    spinner.SetOpacity(0);
    success.SetOpacity(0);
    entry.SetOpacity(1);
    keyboard.SetOpacity(1);
    layout_label.sprite.SetOpacity(1);
    caps.SetOpacity(Plymouth.GetCapslockState());
    set_label(prompt_label, prompt, font, Math.Max(1, width - 48));
}

fun display_normal()
{
    global.mode = "normal";
    clear_masks();
    entry.SetOpacity(0);
    keyboard.SetOpacity(0);
    layout_label.sprite.SetOpacity(0);
    caps.SetOpacity(0);
    set_label(prompt_label, "", font, Math.Max(1, width - 48));
    question.sprite.SetOpacity(0);
    question.image = NULL;
    question.text = NULL;
    title.sprite.SetOpacity(boot);
    subtitle.sprite.SetOpacity(boot);
    set_refresh_rate(240);
}

fun display_password(prompt, count)
{
    if (mode != "password" || prompt_label.text != prompt || count == 0)
        clear_masks();
    global.mode = "password";
    question.sprite.SetOpacity(0);
    question.image = NULL;
    question.text = NULL;
    show_dialog(prompt);
    local.previous_count = password_count;
    global.password_count = Math.Max(0, count);
    global.visible_count = Math.Min(password_count, mask_slots);
    local.first = Math.Max(0, password_count - mask_slots);
    # A ring of 14 sprites and a per-attempt random seed suffice for arbitrarily
    # long input. Variants depend only on position and seed, so backspacing can
    # reveal older positions without retaining an unbounded cosmetic history.
    for (local.slot = 0; local.slot < mask_slots; local.slot++)
    {
        if (masks[local.slot].index < local.first || masks[local.slot].index >= password_count)
        {
            masks[local.slot].sprite.SetOpacity(0);
            masks[local.slot].index = -1;
        }
    }
    for (local.index = local.first; local.index < password_count; local.index++)
    {
        local.slot = local.index % mask_slots;
        local.mask = masks[local.slot];
        if (local.mask.index != local.index)
        {
            local.mask.index = local.index;
            local.random = Math.Sin((local.index + 1) * 12.9898 + mask_seed * 78.233) * 43758.5453;
            local.mask.variant = Math.Int((local.random - Math.Int(local.random)) * 7);
            local.mask.started = clock - 1;
            if (local.index >= local.previous_count)
                local.mask.started = clock;
            local.mask.frame = Math.Min(11, Math.Int((clock - local.mask.started) * 11 / 0.18));
            local.mask.sprite.SetImage(shape_frames[local.mask.variant * 12 + local.mask.frame]);
        }
        local.mask.sprite.SetOpacity(1);
    }
    if (password_count > local.previous_count)
        set_refresh_rate(240);
    layout();
}

fun display_question(prompt, text)
{
    if (mode != "question")
        clear_masks();
    global.mode = "question";
    show_dialog(prompt);
    if (text == NULL)
        text = "";
    if (question.text != text || !question.image)
    {
        question.text = text;
        question.image = Image.Text(text + "|", 0.890196, 0.890196, 0.913725, 1, font, "left");
        if (question.image.GetWidth() > 336)
            question.image = question.image.Crop(question.image.GetWidth() - 336, 0, 336, question.image.GetHeight());
        question.sprite.SetImage(question.image);
    }
    question.sprite.SetOpacity(1);
    layout();
}

fun render_messages()
{
    local.text = "";
    for (local.index = 0; local.index < message_count; local.index++)
    {
        if (local.index > 0)
            local.text += "\n";
        local.text += messages[local.index];
    }
    set_label(message_label, local.text, font, Math.Max(1, width - 48));
    layout();
}

fun display_message(text)
{
    messages[message_count] = text;
    global.message_count++;
    render_messages();
}

fun hide_message(text)
{
    for (local.index = 0; local.index < message_count; local.index++)
    {
        if (messages[local.index] == text)
        {
            global.message_count--;
            for (local.next = local.index; local.next < message_count; local.next++)
                messages[local.next] = messages[local.next + 1];
            messages[message_count] = NULL;
            render_messages();
            return;
        }
    }
}

fun update_status(status)
{
    # Neither display_normal, root-mounted nor generic boot progress proves
    # cryptroot authentication. Only the root device helper emits this status.
    if (boot && !unlocked && status == "cryptroot-unlocked")
    {
        global.unlocked = 1;
        global.success_started = clock;
        set_refresh_rate(240);
    }
}

fun refresh()
{
    global.clock += 1 / refresh_rate;
    if (width != Window.GetWidth() || height != Window.GetHeight() || origin_x != Window.GetX() || origin_y != Window.GetY())
    {
        global.width = Window.GetWidth();
        global.height = Window.GetHeight();
        global.origin_x = Window.GetX();
        global.origin_y = Window.GetY();
        set_label(prompt_label, prompt_label.text, font, Math.Max(1, width - 48));
        set_label(message_label, message_label.text, font, Math.Max(1, width - 48));
        layout();
    }
    local.animating = 0;
    if (mode == "normal")
    {
        if (!unlocked)
        {
            local.frame = Math.Int(clock * 240) % 1092;
            if (local.frame != spinner_frame)
            {
                spinner.SetImage(spinner_frames[local.frame]);
                global.spinner_frame = local.frame;
            }
            spinner.SetOpacity(1);
            success.SetOpacity(0);
            local.animating = 1;
        }
        else
        {
            # Freeze the current spinner image and crossfade with smoothstep.
            local.t = Math.Min(1, (clock - success_started) / 0.3);
            local.opacity = local.t * local.t * (3 - 2 * local.t);
            spinner.SetOpacity(1 - local.opacity);
            success.SetOpacity(local.opacity);
            local.animating = local.t < 1;
        }
    }
    if (mode != "normal")
        caps.SetOpacity(Plymouth.GetCapslockState());
    if (mode == "password")
    {
        for (local.slot = 0; local.slot < mask_slots; local.slot++)
        {
            local.mask = masks[local.slot];
            if (local.mask.index >= 0)
            {
                local.frame = Math.Min(11, Math.Int((clock - local.mask.started) * 11 / 0.18));
                if (local.frame != local.mask.frame)
                {
                    local.mask.sprite.SetImage(shape_frames[local.mask.variant * 12 + local.frame]);
                    local.mask.frame = local.frame;
                }
                if (local.frame < 11)
                    local.animating = 1;
            }
        }
    }
    if (local.animating)
        set_refresh_rate(240);
    else
        set_refresh_rate(30);
}

if (boot)
{
    set_label(title, "System is encrypted.", title_font, Math.Max(1, width - 48));
    set_label(subtitle, "Verify your identity.", font, Math.Max(1, width - 48));
}
set_label(layout_label, keymap, font, 160);
layout_label.sprite.SetOpacity(0);
layout();

# Core replays prompts/messages after Escape, but not status updates. The
# packaged symlink targets /run/plymouth/cryptroot-unlocked.png, atomically
# installed from unlock-success.png only after the actual root device exists.
# Image() prefixes ImageDir even for absolute filenames; missing images are NULL.
if (boot && Image("cryptroot-unlocked.png"))
    update_status("cryptroot-unlocked");

# Do not register keyboard-input or the raw display-prompt callback. Core calls
# display_password(count) / display_question(text) first, and owns all input,
# validation, terminal prompts and the Escape/details fallback itself.
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
Plymouth.SetUpdateStatusFunction(update_status);
Plymouth.SetRefreshFunction(refresh);
