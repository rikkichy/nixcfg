{ config, pkgs, lib, terminalColours, ... }:

let
  yaziSession = pkgs.writeShellScript "yazi-session" ''
    palette=${lib.escapeShellArg "${dirOf terminalColours}/sequences.txt"}
    if [ -r "$palette" ]; then
      ${pkgs.coreutils}/bin/cat -- "$palette"
    fi
    exec ${lib.getExe config.programs.yazi.finalPackage} "$@"
  '';
  yaziOpen = pkgs.writeShellApplication {
    name = "yazi-open";
    text = ''
      exec ${lib.getExe config.programs.foot.package} --app-id=yazi --title=Yazi -- ${yaziSession} "$@"
    '';
  };
  waveXlrKeepalive = pkgs.runCommandCC "wave-xlr-keepalive" {
    nativeBuildInputs = [ pkgs.pkg-config ];
    buildInputs = [ pkgs.json_c ];
    meta.mainProgram = "wave-xlr-keepalive";
  } ''
    mkdir -p "$out/bin"
    $CC -std=c11 -O2 -Wall -Wextra -Werror \
      ${../../pkgs/wave-xlr-keepalive.c} \
      $(pkg-config --cflags --libs json-c) \
      -o "$out/bin/wave-xlr-keepalive"
  '';
in
{
  home.activation.osuSettings = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    osudir="${config.home.homeDirectory}/.local/share/osu"
    run mkdir -p "$osudir"
    for f in game.ini input.json; do
      if [ ! -e "$osudir/$f" ]; then
        run cp ${../../dotfiles/gaming/osu}/"$f" "$osudir/$f"
        run chmod u+w "$osudir/$f"
      fi
    done
  '';

  # Preserve old generated files, but stop loading them alongside the MK1-only policy.
  home.activation.retireOpenWave = lib.hm.dag.entryBetween [ "reloadSystemd" ] [ "linkGeneration" ] ''
    openwave_legacy=(
      ${lib.escapeShellArg "${config.xdg.configHome}/wireplumber/wireplumber.conf.d/51-openwave-wave-xlr.conf"}
      ${lib.escapeShellArg "${config.xdg.configHome}/pipewire/pipewire.conf.d/52-openwave-mixes.conf"}
      ${lib.escapeShellArg "${config.xdg.configHome}/systemd/user/openwave.service"}
      ${lib.escapeShellArg "${config.xdg.configHome}/autostart/openwave.desktop"}
      ${lib.escapeShellArg "${config.xdg.configHome}/autostart/openwave-autostart.desktop"}
      ${lib.escapeShellArg "${config.xdg.dataHome}/applications/openwave.desktop"}
    )
    for old in "''${openwave_legacy[@]}"; do
      if [[ -L "$old" || ( -e "$old" && ! -f "$old" ) ]]; then
        echo "Inspect legacy OpenWave integration before activation: $old" >&2
        exit 1
      fi
      if [[ -f "$old" ]] && ! ${pkgs.gnugrep}/bin/grep -Eq \
        '^(# OpenWave|# GENERATED by OpenWave |Name=OpenWave$|Description=OpenWave Audio Manager$)' "$old"; then
        echo "Unrecognized OpenWave integration preserved; inspect before activation: $old" >&2
        exit 1
      fi
    done
    for old in "''${openwave_legacy[@]}"; do
      if [[ -f "$old" ]]; then
        run ${pkgs.coreutils}/bin/mv -T --backup=numbered -- "$old" "$old.before-wave-xlr-mk1"
      fi
    done
  '';

  dconf.settings."org/gnome/desktop/interface" = {
    gtk-theme = "adw-gtk3-dark";
    color-scheme = "prefer-dark";
    icon-theme = "Papirus-Dark";
  };

  gtk = {
    enable = true;
    gtk2.enable = false;
    gtk3 = {
      extraConfig.gtk-application-prefer-dark-theme = 0;
      bookmarks = [
        "file://${config.home.homeDirectory}/Pictures/Screenshots"
        "file://${config.home.homeDirectory}/Documents"
        "file://${config.home.homeDirectory}/Downloads"
      ];
    };
    gtk4.extraConfig.gtk-application-prefer-dark-theme = 0;
  };

  services.mpris-proxy.enable = true;

  programs.yazi = {
    enable = true;
    enableFishIntegration = true;
    shellWrapperName = "y";
    keymap.mgr.prepend_keymap = [
      { on = [ "g" "s" ]; run = "cd ~/Pictures/Screenshots"; desc = "Screenshots"; }
      { on = [ "g" "D" ]; run = "cd ~/Documents"; desc = "Documents"; }
      { on = [ "g" "d" ]; run = "cd ~/Downloads"; desc = "Downloads"; }
    ];
  };

  home.packages = [ yaziOpen ];
  xdg.desktopEntries.yazi = {
    name = "Yazi File Manager";
    icon = "yazi";
    exec = "${lib.getExe yaziOpen} %f";
    terminal = false;
    categories = [ "System" "FileManager" "FileTools" ];
    mimeType = [ "inode/directory" ];
  };

  xdg.mimeApps = {
    enable = true;
    defaultApplications = {
      "text/html" = "brave-origin.desktop";
      "x-scheme-handler/http" = "brave-origin.desktop";
      "x-scheme-handler/https" = "brave-origin.desktop";
      "x-scheme-handler/about" = "brave-origin.desktop";
      "x-scheme-handler/unknown" = "brave-origin.desktop";
      "inode/directory" = "yazi.desktop";
      "video/mp4" = "mpv.desktop";
      "video/x-matroska" = "mpv.desktop";
      "audio/mpeg" = "mpv.desktop";
    }
    // lib.genAttrs [
      "image/png"
      "image/jpeg"
      "image/gif"
      "image/webp"
      "image/avif"
      "image/heic"
      "image/heif"
      "image/jxl"
      "image/bmp"
      "image/tiff"
      "image/svg+xml"
    ] (_: "swayimg.desktop")
    // lib.genAttrs [
      "application/x-osu-beatmap"
      "application/x-osu-storyboard"
      "application/x-osu-skin-archive"
      "application/x-osu-beatmap-archive"
      "application/x-osu-replay"
      "x-scheme-handler/osu"
    ] (_: "osu!.desktop");
  };

  systemd.user.services.wave-xlr-keepalive = {
    Unit = {
      Description = "Wave XLR MK1 capture keepalive";
      Requires = [ "pipewire.service" ];
      Wants = [ "wireplumber.service" ];
      After = [ "pipewire.service" "wireplumber.service" ];
      PartOf = [ "pipewire.service" ];
      Conflicts = [ "openwave.service" "openwave-gui.service" ];
    };
    Service = {
      ExecStart = lib.getExe waveXlrKeepalive;
      Environment = [ "PATH=${lib.makeBinPath [ pkgs.pipewire ]}" ];
      Restart = "on-failure";
      RestartSec = "3s";
      TimeoutStopSec = "10s";
      KillMode = "control-group";
      NoNewPrivileges = true;
      UMask = "0077";
    };
    Install.WantedBy = [ "pipewire.service" ];
  };

  systemd.user.services.tg-ws-proxy = {
    Unit = {
      Description = "Local MTProto proxy for Telegram";
      After = [ "network-online.target" ];
      Wants = [ "network-online.target" ];
    };
    Service = {
      StateDirectory = "tg-ws-proxy";
      StateDirectoryMode = "0700";
      ExecStart = toString (pkgs.writeShellScript "tg-ws-proxy-start" ''
        set -eu
        dir="$STATE_DIRECTORY"
        if [ ! -s "$dir/secret" ]; then
          ${pkgs.openssl}/bin/openssl rand -hex 16 > "$dir/secret"
          chmod 600 "$dir/secret"
        fi
        exec ${pkgs.tg-ws-proxy}/bin/tg-ws-proxy \
          --host 127.0.0.1 --port 1443 --secret "$(cat "$dir/secret")"
      '');
      Restart = "on-failure";
      RestartSec = "5s";
      Slice = "session.slice";
    };
    Install.WantedBy = [ "default.target" ];
  };

  xdg.configFile = {
    "qtengine/config.json" = {
      force = true;
      text = builtins.toJSON {
        theme = {
          colorScheme = "${config.home.homeDirectory}/.config/qtengine/scheme.colors";
          iconTheme = "Papirus-Dark";
          style = "Darkly";
          font = { family = "Google Sans Flex"; size = 12; weight = -1; };
          fontFixed = { family = "DepartureMono Nerd Font"; size = 12; weight = -1; };
        };
        misc = {
          menusHaveIcons = true;
          singleClickActivate = false;
          shortcutsForContextMenus = true;
        };
      };
    };

    "gtk-3.0/bookmarks".force = true;
  };
}
