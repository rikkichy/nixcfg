{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // NixOS_small, not NixOS: the module box below renders 11 rows, and the
    // full logo is 21, so it would hang ten lines past the box and leave it
    // floating at the top. The small variant is 8 rows and sits beside the
    // box, with the top padding centring it against the taller box.
    "logo": {
        "type": "builtin",
        "source": "NixOS_small",
        "padding": { "top": 2, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[38;5;16m", "\u001b[38;5;17m", "\u001b[38;5;18m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{>22} │"
        },
        {
            "type": "shell",
            "key": "│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "│ {$3}󰻠{$1}  cpu   ",
            "format": "{$3}   NVIDIA Grace (2592){$1} │"
        },
        {
            "type": "custom",
            "key": "│ {$3}󰢮{$1}  gpu   ",
            "format": "{$3}   72x GB300 Blackwell{$1} │"
        },
        {
            "type": "custom",
            "key": "│ {$3}{$1}  vram  ",
            "format": "{$3}       20.00 TiB HBM3e{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$3}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f TiB / 17.00 TiB\",$3/$2*17}'",
            "format": "{$3}{>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "│ 󰒋  host  ",
            "format": "  GIGABYTE GB300 NVL72 │"
        },
        {
            "type": "os",
            "key": "│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
