{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "NixOS_small",
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[38;5;16m", "\u001b[38;5;17m", "\u001b[38;5;18m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}󰌽{$1}  kernel",
            "format": "{$2}{release>24}{$1} │"
        },
        {
            "type": "cpu",
            "key": "│ {$3}󰻠{$1}  cpu   ",
            "format": "{$3}{name>19} ({cores-logical}){$1} │"
        },
        {
            "type": "gpu",
            "key": "│ {$3}󰢮{$1}  gpu   ",
            "format": "{$3}{name>24}{$1} │",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "│ {$3}󰍛{$1}  mem   ",
            "format": "{$3}{used>12} / {total}{$1} │"
        },
        {
            "type": "os",
            "key": "│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>24}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────╯"
        },
        "break"
    ]
}
